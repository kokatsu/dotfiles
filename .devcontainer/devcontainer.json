{
  "name": "claude-code-sandbox",
  // コード名のタグなら Renovate は digest だけを更新し、LTS の移行は手で行う
  "image": "mcr.microsoft.com/devcontainers/base:resolute@sha256:b377a08d19467bcc08180cb95098448cac31c1a8423e287ce709a9eb09e14762",
  "features": {
    // エージェントとその設定、フックを Home Manager で配置する (.devcontainer/apply-home.sh)
    "ghcr.io/devcontainers/features/nix:1": {
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },
  "remoteUser": "vscode",
  "initializeCommand": [
    "${localWorkspaceFolder}/.devcontainer/ensure-bind-sources.sh"
  ],
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "containerEnv": {
    "TZ": "${localEnv:TZ:Asia/Tokyo}",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    // 上の設定で feature flag を取得しなくなり、入力欄に端末のカーソルを使う既定が flag から取れない
    "CLAUDE_CODE_NATIVE_CURSOR": "1",
    // ホストと同じ場所に置き、ホスト向けの設定に書かれたパスをそのまま通す
    "CLAUDE_CONFIG_DIR": "/home/vscode/.config/claude",
    "CODEX_HOME": "/home/vscode/.config/codex",
    "PI_CODING_AGENT_DIR": "/home/vscode/.config/pi"
  },
  "remoteEnv": {
    // devcontainer exec はホストの端末の情報を渡さず TERM=xterm になり、Claude Code の色数が落ちる
    "TERM": "${localEnv:TERM}",
    "COLORTERM": "${localEnv:COLORTERM}",
    // ホストでは Home Manager の sessionVariables が設定している
    "CC_STATUSLINE_THEME": "${localEnv:CC_STATUSLINE_THEME}",
    // Home Manager が入れるエージェントとフック
    "PATH": "/home/vscode/.nix-profile/bin:${containerEnv:PATH}",
    // 外へ出る通信は init-firewall.sh が起動する tinyproxy を通す。containerEnv にすると、tinyproxy より先に
    // entrypoint が起動する nix-daemon にも渡る
    "HTTPS_PROXY": "http://127.0.0.1:3128",
    "HTTP_PROXY": "http://127.0.0.1:3128",
    "NO_PROXY": "localhost,127.0.0.1"
  },
  // tinyproxy は postStartCommand まで動いていないので、ここではプロキシを使わない。
  // tinyproxy パッケージは logrotate 経由で systemd や systemd-resolved まで入れるため、本体の tinyproxy-bin だけを入れる
  "postCreateCommand": "unset HTTPS_PROXY HTTP_PROXY NO_PROXY && sudo chown vscode:vscode /home/vscode/.config /home/vscode/.config/claude /home/vscode/.config/codex /home/vscode/.config/pi && sudo apt-get update && sudo apt-get install -y iptables iproute2 curl tinyproxy-bin && sudo useradd --system --no-create-home --shell /usr/sbin/nologin tinyproxy && sudo install -d -o tinyproxy -g tinyproxy /var/log/tinyproxy && sudo install -D -m 0644 .devcontainer/tinyproxy.conf /etc/tinyproxy/tinyproxy.conf && sudo install -m 0644 .devcontainer/tinyproxy-allow.txt /etc/tinyproxy/allow.txt && sudo install -m 0755 .devcontainer/init-firewall.sh /usr/local/bin/init-firewall.sh && sudo sh -c 'echo \"vscode ALL=(root) NOPASSWD: /usr/local/bin/init-firewall.sh\" > /etc/sudoers.d/vscode && chmod 0440 /etc/sudoers.d/vscode' && .devcontainer/apply-home.sh",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand",
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.config/claude,type=volume",
    "source=codex-config-${devcontainerId},target=/home/vscode/.config/codex,type=volume",
    "source=pi-config-${devcontainerId},target=/home/vscode/.config/pi,type=volume",
    // ホストの git やツールが実行・読み込みするもののうち、書き換えても git status に出ないものを読み取り専用にする。
    // 足すときは ensure-bind-sources.sh にも足す
    "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly",
    // linked worktree では .git が参照ファイルのため、次の 2 つの bind で起動に失敗する
    "source=${localWorkspaceFolder}/.git/hooks,target=${containerWorkspaceFolder}/.git/hooks,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/config,target=${containerWorkspaceFolder}/.git/config,type=bind,readonly",
    "source=${localWorkspaceFolder}/.lefthook-local.jsonc,target=${containerWorkspaceFolder}/.lefthook-local.jsonc,type=bind,readonly",
    "source=${localWorkspaceFolder}/.gitleaks.local.toml,target=${containerWorkspaceFolder}/.gitleaks.local.toml,type=bind,readonly",
    "source=${localWorkspaceFolder}/.claude/settings.local.json,target=${containerWorkspaceFolder}/.claude/settings.local.json,type=bind,readonly",
    "source=${localWorkspaceFolder}/.config/nvim/lua/plugins/snacks/exclude.lua,target=${containerWorkspaceFolder}/.config/nvim/lua/plugins/snacks/exclude.lua,type=bind,readonly",
    "source=${localWorkspaceFolder}/.config/wezterm/backgrounds.lua,target=${containerWorkspaceFolder}/.config/wezterm/backgrounds.lua,type=bind,readonly",
    // home-manager switch がホストの ~/.config/zsh へコピーし、ホストの zsh が読む
    "source=${localWorkspaceFolder}/.config/zsh/config.d,target=${containerWorkspaceFolder}/.config/zsh/config.d,type=bind,readonly",
    "source=${localWorkspaceFolder}/.config/zsh/functions.d,target=${containerWorkspaceFolder}/.config/zsh/functions.d,type=bind,readonly"
  ]
}
