+fn heavy_line_symbol(symbol: &'static str) -> &'static str {
+    match symbol {
+        "┼" => "╋",
+        "┤" => "┫",
+        "├" => "┣",
+        "┴" => "┻",
+        "┬" => "┳",
+        "│" => "┃",
+        "─" => "━",
+        "┌" => "┏",
+        "┐" => "┓",
+        "└" => "┗",
+        "┘" => "┛",
+        other => other,
+    }
+}
