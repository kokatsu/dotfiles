#!/usr/bin/env bash
set -euo pipefail
#
# memo: タイムスタンプ付きの単独メモファイルを作成する。
#
# Usage:
#   memo              新規メモファイルを作成してエディタで開く
#   memo --local      ローカル専用メモ (.local.md) を作成して開く
#   memo --no-edit    エディタを起動せず、作成したパスのみ出力する
#   memo -h, --help   このヘルプを表示
#
# 仕様:
#   - 保存先は Git リポジトリルート配下の
#     .kokatsu/memo/YYYY/MM/DD/YYYY-MM-DD-HHMMSS[.local].md
#   - 生成されるのは空ファイル。ファイル名自体がタイムスタンプなので本文に見出しは書かない
#   - 作成したパスは常に stdout に 1 行で出力する（エディタ起動の有無に関わらず）。
#     進捗メッセージは stderr に出すので、`memo --no-edit` の stdout はパスのみになり、
#     Neovim など呼び出し側がそのまま開ける
#   - 同一秒に 2 回実行してパスが衝突した場合は、上書きせず既存ファイルを開く

# 通知メッセージ用の色 (出力先は stderr)。
# Neovim の vim.system() のように呼び出し元がパイプで受け取る場合、
# ANSI エスケープが混入しないよう stderr が tty のときだけ付ける。
color_red=''
color_green=''
color_blue=''
color_reset=''
if [[ -t 2 ]]; then
  color_red=$'\e[0;31m'
  color_green=$'\e[0;32m'
  color_blue=$'\e[0;34m'
  color_reset=$'\e[0m'
fi

die() {
  echo "${color_red}エラー: $1${color_reset}" >&2
  exit 1
}

show_help() {
  # ヘルプは stdout に出るので、色の有無は stderr ではなく fd 1 で判定する
  local green='' yellow='' reset=''
  if [[ -t 1 ]]; then
    green=$'\e[0;32m'
    yellow=$'\e[1;33m'
    reset=$'\e[0m'
  fi

  cat <<EOF
${green}memo${reset} - タイムスタンプ付き単独メモを作成するツール

${yellow}使い方:${reset}
  memo              新規メモファイルを作成してエディタで開く
  memo --local      ローカル専用メモ (.local.md) を作成して開く
  memo --no-edit    エディタを起動せず、作成したパスのみ出力する
  memo -h, --help   このヘルプを表示

${yellow}保存先:${reset}
  <repo>/.kokatsu/memo/YYYY/MM/DD/YYYY-MM-DD-HHMMSS.md
  <repo>/.kokatsu/memo/YYYY/MM/DD/YYYY-MM-DD-HHMMSS.local.md  (--local)
EOF
}

local_memo=false
no_edit=false

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    show_help
    exit 0
    ;;
  --local) local_memo=true ;;
  --no-edit) no_edit=true ;;
  *) die "不明なオプションです: $1 (memo -h でヘルプを表示)" ;;
  esac
  shift
done

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "Gitリポジトリが見つかりません"

# ディレクトリとファイル名を 1 回の date 呼び出しから組み立てる
# (別々に呼ぶと日付境界をまたいだときに不整合が出る)
read -r year month day hms < <(date +'%Y %m %d %H%M%S')

suffix=".md"
if [[ "$local_memo" == true ]]; then
  suffix=".local.md"
fi

dir="$repo_root/.kokatsu/memo/$year/$month/$day"
file="$dir/$year-$month-$day-$hms$suffix"

mkdir -p "$dir" || die "ディレクトリの作成に失敗しました"

# noclobber (set -C) 下のリダイレクトは O_EXCL 相当で、存在チェックと作成の間に
# 別プロセスが割り込んでも上書きしない
if (
  set -C
  : >"$file"
) 2>/dev/null; then
  echo "${color_green}✓ メモを作成しました: $file${color_reset}" >&2
elif [[ -e "$file" ]]; then
  echo "${color_blue}ℹ 既存ファイルを開きます: $file${color_reset}" >&2
else
  die "ファイルの作成に失敗しました"
fi

echo "$file"

if [[ "$no_edit" == false ]]; then
  "${EDITOR:-vi}" "$file"
fi
