#!/usr/bin/env bash
set -euo pipefail

# feed-watch と同じロックを使う状態更新は Deno から feed-status.sh を呼ぶ。
script_path="$(readlink -f "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")/.." && pwd)"
export OPML_DIR="${FEED_WATCH_OPML_DIR:-$HOME/.config/bulletty}"
# shellcheck source=scripts/feed-status.sh
source "$repo_dir/scripts/feed-status.sh"
# shellcheck source=scripts/feed-opml.sh
source "$repo_dir/scripts/feed-opml.sh"

STATUS_DIR=${FEED_WATCH_STATUS_DIR:-$("$repo_dir/bin/status-dir" feed-watch)} || {
  echo "Windows mount not available, skipping." >&2
  exit 0
}
STATUS_FILE="$STATUS_DIR/status.json"
[[ -f "$STATUS_FILE" ]] || {
  echo "status.json not found. Run feed-watch check first." >&2
  exit 1
}

exec 8>"$STATUS_FILE.summarize.lock"
feed_lock 8 "$STATUS_FILE.summarize.lock"
# ロックを取れなかった実行が、実行中のブラウザを閉じないようにする。
cleanup() {
  feed_run agent-browser --session feed-summarize close >/dev/null 2>&1 || true
}
trap cleanup EXIT

umask 077
entries=$(feed_opml_entries) || entries=null
feed_run deno run --no-prompt --allow-read --allow-write --allow-run --allow-env \
  "$repo_dir/scripts/feed-summarize.ts" "$STATUS_FILE" "$entries" "$@"
