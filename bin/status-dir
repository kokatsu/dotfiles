#!/usr/bin/env bash
set -euo pipefail

# status-dir: WezTerm のステータスバーが読むキャッシュディレクトリを解決して出力する
#
# Usage:
#   status-dir <name>   例: status-dir feed-watch → <Windows プロファイル>/.cache/feed-watch
#
# WezTerm は Windows 側で動くため WSL では Windows プロファイル配下を使い、macOS は
# 同じマシンの ~/.cache を使う。XDG_CACHE_HOME は見ない: 読み手 (format.lua) と
# 固定パスで揃えるため

name=${1:?usage: status-dir <name>}
# shellcheck source=scripts/windows-profile.sh
source "$(dirname "$(readlink -f "$0")")/../scripts/windows-profile.sh"

if [[ $(uname -s) == Darwin ]]; then
  echo "$HOME/.cache/$name"
  exit 0
fi

CMD_EXE=${STATUS_DIR_CMD_EXE:-/mnt/c/Windows/System32/cmd.exe}
# systemd user unit の PATH は Nix のパッケージだけで、/usr/bin を含まない
WSLPATH=${STATUS_DIR_WSLPATH:-/usr/bin/wslpath}
USERS_DIR=${STATUS_DIR_USERS_DIR:-/mnt/c/Users}

# systemd user unit 内では WSL interop が無効で cmd.exe が使えないことがある
profile=$(read_userprofile "$CMD_EXE")
if [[ -n "$profile" ]]; then
  profile_dir=$("$WSLPATH" -u "$profile" 2>/dev/null) || profile_dir=""
  if [[ -n "$profile_dir" && -d "$profile_dir" ]]; then
    echo "$profile_dir/.cache/$name"
    exit 0
  fi
fi

# Windows のプロファイルを解決できないときは、WSL のユーザーと同名のプロファイルだけを
# 候補にする。/mnt/c/Users/* の先頭を拾う推測はしない: 非システムのプロファイルが
# 複数あるホストでは別ユーザーへ書き込みうる
if [[ -d "$USERS_DIR/$USER" ]]; then
  echo "$USERS_DIR/$USER/.cache/$name"
  exit 0
fi

exit 1
