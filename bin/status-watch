#!/usr/bin/env bash
set -euo pipefail

# status-watch: Claude / OpenAI / GitHub の障害情報を取得し、WezTerm ステータスバーが
# 読む JSON を更新する
#
# Usage:
#   status-watch check - 各サービスの summary.json を取得してキャッシュを更新する
#
# 各 Statuspage の summary.json は全体の indicator、コンポーネント別の状態、
# 進行中のインシデント、予定されたメンテナンスをまとめて返す

CLAUDE_SUMMARY_URL=${STATUS_WATCH_CLAUDE_URL:-${STATUS_WATCH_URL:-https://status.claude.com/api/v2/summary.json}}
OPENAI_SUMMARY_URL=${STATUS_WATCH_OPENAI_URL:-https://status.openai.com/api/v2/summary.json}
GITHUB_SUMMARY_URL=${STATUS_WATCH_GITHUB_URL:-https://www.githubstatus.com/api/v2/summary.json}

# --- 出力先を決定 ---
get_status_dir() {
  if [[ -n "${STATUS_WATCH_STATUS_DIR:-}" ]]; then
    echo "$STATUS_WATCH_STATUS_DIR"
    return
  fi

  # macOS は WezTerm とこのスクリプトが同じマシンにいるので Windows プロファイルを
  # 探さない。XDG_CACHE_HOME は見ない: feed-watch / disk-watch も .cache 直下の固定
  # パスで、読み手 (format.lua / status-open.sh) と揃わなくなるのを避ける
  if [[ $(uname -s) == Darwin ]]; then
    echo "$HOME/.cache/status-watch"
    return
  fi

  local winuser
  # 対話シェルでも systemd user unit の中でも cmd.exe は解決に使える
  # (systemd-run --user 経由で実測)
  winuser=$(/mnt/c/Windows/System32/cmd.exe /C "echo %USERNAME%" 2>/dev/null | tr -d '\r') || true
  if [[ -n "$winuser" && -d "/mnt/c/Users/$winuser" ]]; then
    echo "/mnt/c/Users/$winuser/.cache/status-watch"
    return
  fi

  # feed-watch / disk-watch が持つ /mnt/c/Users/* の推測 fallback は置かない。
  # このホストには非システムの Windows プロファイルが複数あり、最初の 1 件を
  # 選ぶと別ユーザーのディレクトリへ書き込む
  return 1
}

fetch_status() (
  local status_dir=$1
  local filename=$2
  local summary_url=$3
  local status_file summary payload temp_file

  status_file="$status_dir/$filename"

  # 取得に失敗してもキャッシュは更新せず前回の内容を残す。呼び出し元が unit を
  # failed にして journal に理由を残し、次の周期で再試行する
  summary=$(curl -sfL --max-time 10 "$summary_url") || {
    echo "Failed to fetch $summary_url" >&2
    return 1
  }

  # operational 以外のコンポーネントと、未解決のインシデントだけを残す。
  # 全部入りのまま WezTerm 側へ渡すと Lua で絞り込むことになる。
  # scheduled_maintenances は載せない。summary には来週の予定 (status=scheduled) も
  # 混ざるうえ、バーは「今おかしいか」を出す場所であり、影響のある実施中の
  # メンテナンスは component が under_maintenance になれば components 側で拾える
  payload=$(jq -c --argjson ts "$(date +%s)" '
    {
      indicator: .status.indicator,
      description: .status.description,
      components: [
        (.components // [])[]
        | select(.status != "operational")
        | {name, status}
      ],
      incidents: [(.incidents // [])[] | {name, impact, status}],
      last_updated: $ts,
    }
  ' <<<"$summary") || {
    echo "Failed to parse the status summary" >&2
    return 1
  }

  # WezTerm は 1 秒ごとにこのファイルを読む。書き込み途中を読ませると
  # json_parse が失敗して表示が飛ぶため、一時ファイルに書いてから rename する
  mkdir -p "$status_dir" || return 1
  temp_file=$(mktemp "$status_dir/.$filename.XXXXXX") || return 1
  trap 'rm -f "${temp_file:-}"' EXIT

  printf '%s\n' "$payload" >"$temp_file" || return 1
  mv -f "$temp_file" "$status_file" || return 1
  trap - EXIT
)

# --- check サブコマンド ---
cmd_check() {
  local status_dir
  local failed=0

  status_dir=$(get_status_dir) || {
    echo "Could not resolve the Windows profile directory." >&2
    exit 1
  }

  # 1 つの取得に失敗しても残りの更新は試みる。status.json は既存の Claude
  # キャッシュ名を維持し、他のサービスはサービス名のファイルへ分離する
  fetch_status "$status_dir" status.json "$CLAUDE_SUMMARY_URL" || failed=1
  fetch_status "$status_dir" openai.json "$OPENAI_SUMMARY_URL" || failed=1
  fetch_status "$status_dir" github.json "$GITHUB_SUMMARY_URL" || failed=1
  return "$failed"
}

# --- メイン ---
case "${1:-check}" in
check) cmd_check ;;
*)
  echo "Usage: status-watch [check]" >&2
  exit 1
  ;;
esac
