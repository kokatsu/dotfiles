#!/usr/bin/env bash
set -euo pipefail

# feed-watch: フィードの更新を監視し、WezTerm ステータスバーに表示する
# フィードリストは bulletty の OPML ファイルから読み込む
#
# Usage:
#   feed-watch check          - 全フィードをチェックし status.json を更新
#   feed-watch read           - fzf でフィードを選択して既読にする (TAB で複数選択)
#   feed-watch read --all     - 全フィードを既読にする
#   feed-watch read <name>    - 部分一致したフィードを既読にする

OPML_DIR="${FEED_WATCH_OPML_DIR:-$HOME/.config/bulletty}"
script_path="$(readlink -f "$0")"
HELPER="$(cd "$(dirname "$script_path")/.." && pwd)/scripts/feed-watch-helper.ts"
# shellcheck source=scripts/feed-status.sh
source "$(dirname "$script_path")/../scripts/feed-status.sh"

STATUS_DIR=${FEED_WATCH_STATUS_DIR:-$("$(dirname "$script_path")/status-dir" feed-watch)} || {
  echo "Windows mount not available, skipping." >&2
  exit 0
}
STATUS_FILE="$STATUS_DIR/status.json"

# --- フィードからエントリ ID を取得 (Atom/RSS 自動判別) ---
fetch_feed_ids() {
  local url="$1"
  local content
  # --max-time は status-watch と揃えた 10 秒。timer は 5 分間隔なので、応答の
  # 無いフィードが 1 つあるだけで次の起動と重なるのを防ぐ
  content=$(feed_run curl -sfL --max-time 10 "$url") || return 1

  # Atom: <id> タグ (先頭のフィード自体の id はスキップ)
  local atom_ids
  atom_ids=$(echo "$content" | grep -o '<id>[^<]*</id>' | sed 's/<id>\(.*\)<\/id>/\1/' | tail -n +2)
  if [[ -n "$atom_ids" ]]; then
    echo "$atom_ids"
    return
  fi

  # RSS: <guid> タグ
  echo "$content" | grep -oP '<guid[^>]*>\K[^<]+' || true
}

# --- OPML パース: "category|name|xmlUrl|htmlUrl" 行を出力 ---
parse_opml() {
  # feeds*.opml だけを対象にする。bulletty-only.opml は bulletty への import 元
  # として残しつつ、未読カウントからは外すためのファイル
  local files=()
  local f
  for f in "$OPML_DIR"/feeds*.opml; do
    [[ -f "$f" ]] || continue
    files+=("$f")
  done

  if [[ ${#files[@]} -eq 0 ]]; then
    return
  fi

  cat "${files[@]}" | feed_run deno run --no-prompt "$HELPER" parse-opml
}

# --- check サブコマンド ---
cmd_check() (
  # check 同士は通信も含め直列化し、古い取得結果による巻き戻しを防ぐ。
  mkdir -p "$STATUS_DIR"
  exec 8>"$STATUS_FILE.check.lock"
  feed_lock 8 "$STATUS_FILE.check.lock"

  if ! compgen -G "$OPML_DIR/feeds*.opml" >/dev/null; then
    echo "No OPML files matching $OPML_DIR/feeds*.opml" >&2
    exit 1
  fi

  # パース結果を先に確定させる。compgen はファイルの存在しか見ないので、OPML が
  # 空だったり壊れていれば 0 件になりうる。その名前一覧で prune すると全エントリを
  # 消してしまうため、0 件なら status.json を触らずに終わる
  local entries
  entries=$(parse_opml | grep -v '^$') || true
  if [[ -z "$entries" ]]; then
    echo "No feeds parsed from $OPML_DIR/feeds*.opml" >&2
    exit 1
  fi

  # レコードの区切りは NUL なのでシェル変数には積めない。一時ファイルへ書き足す
  local updates
  updates=$(mktemp "${TMPDIR:-/tmp}/feed-watch.XXXXXX") || exit 1
  trap 'rm -f "$updates"' EXIT

  local fetched=0

  while IFS='|' read -r category name xml_url html_url; do
    local ids type

    # GitHub フィード: gh api でコミットSHA を取得
    if [[ "$xml_url" =~ ^https://github\.com/([^/]+/[^/]+)/commits\.atom$ ]]; then
      local repo="${BASH_REMATCH[1]}"
      ids=$(feed_run gh api "repos/$repo/commits?per_page=100" --jq '.[].sha' 2>/dev/null) || {
        echo "Failed to fetch commits for $repo" >&2
        continue
      }
      type=github
    else
      ids=$(fetch_feed_ids "$xml_url" 2>/dev/null) || {
        echo "Failed to fetch feed: $name" >&2
        continue
      }
      type=feed
    fi
    printf '%s\0%s\0%s\0%s\0%s\0' \
      "$name" "$type" "$html_url" "$category" "$ids" >>"$updates"
    fetched=$((fetched + 1))
  done <<<"$entries"

  if [[ $fetched -eq 0 ]]; then
    echo "All feed fetches failed; keeping the previous status" >&2
    exit 1
  fi

  feed_status_update apply_check_results "$updates" "$entries"
)

apply_check_results() {
  local status="$1" updates="$2" entries="$3"
  {
    printf '%s\0%s\0' "$status" "$entries"
    cat "$updates"
  } |
    feed_run deno run --no-prompt "$HELPER" apply-check-results
}

# --- read サブコマンド ---
cmd_read() {
  local target="${1:-}"
  local status
  status=$(feed_status_read)

  local names
  if [[ "$target" == "--all" ]]; then
    # 全フィード既読
    names=null
  elif [[ -z "$target" ]]; then
    # fzf で対話的に選択
    if ! command -v fzf >/dev/null 2>&1; then
      echo "fzf not found" >&2
      exit 1
    fi

    local list
    list=$(echo "$status" | jq -r '
      .feeds | to_entries
      | map(select(.value.unread_count > 0))
      | sort_by(-.value.unread_count)
      | .[] | "\(.value.unread_count)\t\(.key)\t\(.value.category)"
    ')

    if [[ -z "$list" ]]; then
      echo "No unread feeds." >&2
      exit 0
    fi

    local selected
    selected=$(echo "$list" | fzf -m \
      --delimiter=$'\t' --with-nth=1,2,3 \
      --header='TAB: multi-select, Enter: mark as read' \
      --prompt='read> ') || exit 0

    [[ -z "$selected" ]] && exit 0

    names=$(printf '%s\n' "$selected" | cut -f2 | jq -R . | jq -s .)
  else
    # 部分一致で検索
    local matched
    matched=$(echo "$status" | jq -r --arg t "$target" \
      '[.feeds | keys[] | select(contains($t))] | .[0] // ""')

    if [[ -z "$matched" ]]; then
      echo "No feed matching '$target'" >&2
      exit 1
    fi

    names=$(jq -n --arg name "$matched" '[$name]')
  fi

  feed_status_update feed_status_mark_read "$names"
}

# --- メイン ---
case "${1:-}" in
check) cmd_check ;;
read) cmd_read "${2:-}" ;;
*)
  echo "Usage: feed-watch {check|read [--all|<name>]}" >&2
  exit 1
  ;;
esac
