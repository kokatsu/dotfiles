# Dotfiles repository-local commands.
prefix_rule(
    pattern = ["just", ["check", "check-static", "fmt", "nvim-test"]],
    decision = "prompt",
    justification = "The recipes run repository files that the sandboxed agent can edit, so running them outside the sandbox needs approval each time.",
    match = [
        "just check",
        "just check-static",
        "just fmt",
        "just nvim-test",
    ],
    not_match = [
        "just deploy",
        "just test",
    ],
)

prefix_rule(
    pattern = ["nix", "flake", ["metadata", "show"]],
    decision = "allow",
    justification = "Allow read-only flake inspection for this trusted dotfiles repository.",
    match = [
        "nix flake metadata",
        "nix flake show",
    ],
    not_match = [
        "nix flake update",
        "nix flake lock --update-input nixpkgs",
    ],
)
