#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'herdr-peer: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
Usage:
  herdr-peer resolve
  herdr-peer prompt [--timeout MILLISECONDS] [--] "PROMPT"
  herdr-peer read [--lines COUNT]
EOF
  exit 64
}

require_runtime() {
  [[ ${HERDR_ENV:-} == 1 ]] || die 'must run inside a Herdr-managed pane (HERDR_ENV=1)'
  command -v herdr >/dev/null 2>&1 || die 'herdr is not available in PATH'
  command -v jq >/dev/null 2>&1 || die 'jq is not available in PATH'
}

opposite_kind() {
  case $1 in
  claude) printf '%s\n' codex ;;
  codex) printf '%s\n' claude ;;
  *) die "current agent must be claude or codex, got: $1" ;;
  esac
}

parse_session_id() {
  jq -er '
    .agent_session.value as $value |
    if $value == null then
      ""
    elif ($value | type) == "string" and ($value | length) > 0 then
      $value
    else
      error("agent session id must be null or a non-empty string")
    end
  '
}

load_current_context() {
  local current_json current_fields

  current_json=$(herdr pane current --current) || die 'failed to resolve the current pane'
  current_fields=$(jq -er '
    .result.pane |
    [.pane_id, .tab_id, .workspace_id, .agent] |
    @tsv
  ' <<<"$current_json") || die 'current pane response is missing required fields'
  IFS=$'\t' read -r CURRENT_PANE_ID CURRENT_TAB_ID CURRENT_WORKSPACE_ID CURRENT_KIND <<<"$current_fields"
  [[ -n $CURRENT_PANE_ID && -n $CURRENT_TAB_ID && -n $CURRENT_WORKSPACE_ID && -n $CURRENT_KIND ]] ||
    die 'current pane response contains empty required fields'
}

load_target_context() {
  local target_json target_fields

  target_json=$(herdr agent get "$PEER_PANE_ID") || die 'the selected peer no longer exists'
  TARGET_JSON=$(jq -ce '.result.agent' <<<"$target_json") || die 'peer response is missing the agent object'
  target_fields=$(jq -er '
    [.pane_id, .tab_id, .workspace_id, .agent, .agent_status] |
    @tsv
  ' <<<"$TARGET_JSON") || die 'peer response is missing required fields'
  IFS=$'\t' read -r TARGET_PANE_ID TARGET_TAB_ID TARGET_WORKSPACE_ID TARGET_KIND TARGET_STATUS <<<"$target_fields"
  TARGET_SESSION_ID=$(parse_session_id <<<"$TARGET_JSON") ||
    die 'failed to parse the peer agent session id'
  [[ -n $TARGET_PANE_ID && -n $TARGET_TAB_ID && -n $TARGET_WORKSPACE_ID && -n $TARGET_KIND && -n $TARGET_STATUS ]] ||
    die 'peer response contains empty required fields'
}

resolve_peer() {
  local agents_json candidate_json candidate_count peer_fields

  load_current_context
  PEER_KIND=$(opposite_kind "$CURRENT_KIND")

  agents_json=$(herdr agent list) || die 'failed to list agents'
  candidate_json=$(jq -c \
    --arg pane "$CURRENT_PANE_ID" \
    --arg tab "$CURRENT_TAB_ID" \
    --arg workspace "$CURRENT_WORKSPACE_ID" \
    --arg kind "$PEER_KIND" \
    '[.result.agents[] | select(
      .pane_id != $pane and
      .tab_id == $tab and
      .workspace_id == $workspace and
      .agent == $kind
    )]' <<<"$agents_json") || die 'failed to parse the agent list'

  candidate_count=$(jq -r 'length' <<<"$candidate_json")
  [[ $candidate_count == 1 ]] || die "expected exactly one $PEER_KIND peer in tab $CURRENT_TAB_ID, found $candidate_count"

  PEER_JSON=$(jq -c '.[0]' <<<"$candidate_json")
  peer_fields=$(jq -er '.pane_id' <<<"$PEER_JSON") || die 'peer response is missing pane_id'
  PEER_PANE_ID=$peer_fields
  PEER_SESSION_ID=$(parse_session_id <<<"$PEER_JSON") ||
    die 'failed to parse the peer agent session id'

  [[ -n $PEER_PANE_ID ]] || die 'peer response contains an empty pane_id'
  [[ $PEER_PANE_ID != "$CURRENT_PANE_ID" ]] || die 'refusing to target the current pane'
}

validate_peer_identity() {
  local expected_kind

  expected_kind=$(opposite_kind "$CURRENT_KIND")

  [[ $TARGET_PANE_ID != "$CURRENT_PANE_ID" ]] || die 'refusing to target the current pane'
  [[ $TARGET_PANE_ID == "$PEER_PANE_ID" ]] || die 'peer pane changed during resolution'
  [[ $TARGET_TAB_ID == "$CURRENT_TAB_ID" && $TARGET_WORKSPACE_ID == "$CURRENT_WORKSPACE_ID" ]] || die 'peer moved outside the current tab'
  [[ $TARGET_KIND == "$expected_kind" ]] || die "peer is no longer the expected $expected_kind agent"
}

validate_peer() {
  local require_ready=$1
  local require_uninitialized_session=$2

  # Best-effort recheck immediately before the next operation. Herdr does not
  # yet atomically compare an expected session id while submitting a prompt.
  load_current_context
  load_target_context
  validate_peer_identity

  if [[ -n $PEER_SESSION_ID ]]; then
    [[ $TARGET_SESSION_ID == "$PEER_SESSION_ID" ]] || die 'peer agent session changed during resolution'
  elif [[ $require_uninitialized_session == true && -n $TARGET_SESSION_ID ]]; then
    die 'peer agent session initialized during resolution; retry'
  fi

  if [[ $require_ready == true ]]; then
    case $TARGET_STATUS in
    idle | done) ;;
    *) die "peer $PEER_PANE_ID is not ready (status: $TARGET_STATUS)" ;;
    esac
  fi
}

wait_for_initialized_session() {
  local attempt

  for ((attempt = 0; attempt < 50; attempt++)); do
    load_current_context
    load_target_context
    validate_peer_identity
    if [[ -n $TARGET_SESSION_ID ]]; then
      return
    fi
    sleep 0.1
  done

  die 'peer prompt was delivered, but no agent session id was reported; do not retry automatically'
}

print_peer() {
  jq -c '{
    agent,
    agent_status,
    pane_id,
    tab_id,
    workspace_id,
    cwd,
    agent_session_id: .agent_session.value,
    session_state: (if .agent_session.value == null then "uninitialized" else "initialized" end)
  }' <<<"$TARGET_JSON"
}

main() {
  local subcommand=${1:-}
  [[ -n $subcommand ]] || usage
  shift

  require_runtime

  case $subcommand in
  resolve)
    [[ $# -eq 0 ]] || usage
    resolve_peer
    validate_peer false false
    print_peer
    ;;
  prompt)
    local prompt_output timeout_ms=300000
    if [[ ${1:-} == --timeout ]]; then
      [[ $# -ge 2 && ${2:-} =~ ^[1-9][0-9]*$ ]] || usage
      timeout_ms=$2
      shift 2
    fi
    [[ ${1:-} == -- ]] && shift
    [[ $# -eq 1 && -n ${1:-} ]] || usage

    resolve_peer
    validate_peer true true
    prompt_output=$(herdr agent prompt "$PEER_PANE_ID" "$1" --wait --timeout "$timeout_ms")
    if [[ -z $PEER_SESSION_ID ]]; then
      wait_for_initialized_session
    fi
    [[ -z $prompt_output ]] || printf '%s\n' "$prompt_output"
    ;;
  read)
    local line_count=120
    if [[ ${1:-} == --lines ]]; then
      [[ $# -eq 2 && ${2:-} =~ ^[1-9][0-9]*$ ]] || usage
      line_count=$2
      shift 2
    fi
    [[ $# -eq 0 ]] || usage

    resolve_peer
    validate_peer false false
    herdr agent read "$PEER_PANE_ID" --source recent-unwrapped --lines "$line_count"
    ;;
  *) usage ;;
  esac
}

main "$@"
