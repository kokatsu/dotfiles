{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "fileSuggestion": {
    "type": "command",
    "command": "~/.config/claude/file-suggestion.sh"
  },
  "respectGitignore": false,
  "cleanupPeriodDays": 60,
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "CC_STATUSLINE_BAR_WIDTH": "0",
    "CC_STATUSLINE_SHOW_CACHE": "0",
    "CC_STATUSLINE_SHOW_SESSION": "0",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.config/claude/mods/verify-reminder:~/.config/claude/mods/language-guard:~/.config/claude/mods/session-uuid:~/.config/claude/mods/mermaid-ascii",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "DISABLE_UPDATES": "1"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Skill(browser-research)",
      "WebFetch(domain:github.com)",
      "WebSearch"
    ],
    "ask": ["Artifact", "mcp__claude_ai_Claude_Docs"],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/notify.sh permission"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "command -v agent-guard >/dev/null || { echo 'agent-guard not found; run home-manager switch' >&2; exit 2; }; exec agent-guard banned",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "command -v agent-guard >/dev/null || exit 0; exec agent-guard gh-api",
            "if": "Bash(gh api *)"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v agent-guard >/dev/null || { echo 'agent-guard not found; run home-manager switch' >&2; exit 2; }; exec agent-guard managed-paths",
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/herdr/hooks/report-agent-session.sh session claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/herdr-cache-token.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/herdr-cache-token.sh stop",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/ai-writing/check-ai-writing.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/herdr-cache-token.sh compact",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bashOutputMaxChars": 128000,
  "statusLine": {
    "type": "command",
    "command": "CC_STATUSLINE_SHOW_COST=0 cc-statusline",
    "padding": 0
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "session-report@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "codex@openai-codex": true,
    "pstack@cursor-plugins": true
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    }
  },
  "language": "japanese",
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "agentPushNotifEnabled": true
}
