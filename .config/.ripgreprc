# Search hidden files and directories.
--hidden

# Follow symbolic links.
--follow

# Don't respect ignore files (.gitignore, .ignore, etc.).
--no-ignore

# Exclude directories.
--glob=!.anyenv
--glob=!.bun
--glob=!.bundle
--glob=!.cache
--glob=!.cargo
--glob=!.git
--glob=!.vite
--glob=!asset.*
--glob=!debug
--glob=!dist
--glob=!node_modules
--glob=!public
--glob=!result
--glob=!storybook-static
--glob=!target
--glob=!tmp
--glob=!Trash
--glob=!vendor

# Exclude file types.
--glob=!*.lock
--glob=!*.log

# Exclude files.
--glob=!package-lock.json

# Don't print lines longer than this limit.
--max-columns=10000

# Show a preview of suppressed long lines instead of hiding them entirely.
--max-columns-preview

# Searches case insensitively.
--smart-case

# NOTE: --sort=path はここには置かない。RIPGREP_CONFIG_PATH は Neovim の picker や
# fzf / zeno から呼ばれる rg にも効き、--sort は常に単一スレッド実行を強制するため
# (`man rg` の --sort 参照)。picker 側は独自に並べ替えるので恩恵もない。
# 素の rg でソートしたいときは zsh の `rgs` 関数を使う (.config/zsh/functions.zsh)。

# Configure color settings and styles.
## #89b4fa
--colors=path:fg:0x89,0xb4,0xfa
## #a6e3a1
--colors=line:fg:0xa6,0xe3,0xa1
## #f9e2af
--colors=match:bg:0xf9,0xe2,0xaf
## #1e1e2e
--colors=match:fg:0x1e,0x1e,0x2e
--colors=match:style:nobold
