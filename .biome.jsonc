{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  // linter / formatter の設定はグローバル設定 (.config/biome/.biome.jsonc) と共有する。
  // ここではリポジトリ固有の対象範囲だけを決める
  "extends": [".config/biome/.biome.jsonc"],
  "files": {
    "includes": [
      "**",
      "!karabiner-config",
      "!scripts/*.ts",
      "!.claude",
      "!.config/zeno",
      "!.config/claude/hooks",
      "!.config/herdr/hooks"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
